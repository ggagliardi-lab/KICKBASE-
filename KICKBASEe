<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kickbase Meister-Coach KI</title>
    <!-- Tailwind CSS für ein modernes, professionelles Design -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        body { background-color: #0b0f19; color: #f8fafc; }
    </style>
</head>
<body class="min-h-screen p-4 md:p-8 font-sans">

    <div class="max-w-5xl mx-auto">
        <!-- Header -->
        <header class="flex flex-col md:flex-row justify-between items-center mb-8 border-b border-slate-800 pb-6">
            <div>
                <h1 class="text-3xl font-black text-emerald-400 flex items-center gap-2">
                    ⚽ Kickbase Meister-Coach 
                    <span class="text-xs bg-emerald-950 text-emerald-300 border border-emerald-800 px-2.5 py-1 rounded-full">KI + Bundesliga-Expertise</span>
                </h1>
                <p class="text-xs text-slate-400 mt-1">Dein automatisierter Assistent für den Weg zur Meisterschaft.</p>
            </div>
            <div class="mt-4 md:mt-0 flex gap-2 w-full md:w-auto">
                <input type="password" id="apiKey" placeholder="OpenAI API-Key (sk-...)" class="bg-slate-900 border border-slate-700 px-3 py-2 rounded-lg text-sm text-white focus:outline-none focus:border-emerald-500 w-full md:w-64">
                <button onclick="saveApiKey()" class="bg-emerald-600 hover:bg-emerald-500 px-4 py-2 rounded-lg text-sm font-bold transition whitespace-nowrap shadow-md">Key speichern</button>
            </div>
        </header>

        <!-- Hauptbereich Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- Sektion 1: Kickbase Account & Marktdaten -->
            <div class="bg-slate-900/80 border border-slate-800 p-6 rounded-2xl shadow-xl flex flex-col justify-between">
                <div>
                    <h2 class="text-lg font-bold mb-2 text-slate-200 flex items-center gap-2">
                        <span>📊</span> Kader, Markt & Aufstellung
                    </h2>
                    <p class="text-xs text-slate-400 mb-4">
                        Trage hier die Daten deines Kaders, deiner Spieler auf dem Transfermarkt oder die aktuelle Situation an diesem Spieltag ein.
                    </p>
                    <textarea id="marketData" rows="10" class="w-full bg-slate-950 border border-slate-800 p-3 rounded-xl text-sm text-slate-300 focus:outline-none focus:border-emerald-500 leading-relaxed" placeholder="Beispiel:
Mein Kader:
- H. Kane (Bayern, Sturm) - 240 Punkte, MW: 45M
- F. Wirtz (Leverkusen, Mittelfeld) - Verletzt / fraglich

Transfermarkt:
- B. Šeško (Leipzig) - MW: 18M, steigt stark
- Guirassy (Dortmund) - MW: 32M, Konkurrenz bietet mit"></textarea>
                </div>
                <button onclick="analyzeData()" class="mt-4 w-full bg-indigo-600 hover:bg-indigo-500 py-3.5 rounded-xl font-bold transition shadow-lg text-sm flex justify-center items-center gap-2">
                    <span>🤖</span> KI-Analyse & Meister-Taktik starten
                </button>
            </div>

            <!-- Sektion 2: KI-Expertenrat -->
            <div class="bg-slate-900/80 border border-slate-800 p-6 rounded-2xl shadow-xl flex flex-col justify-between">
                <div>
                    <h2 class="text-lg font-bold mb-2 text-slate-200 flex items-center gap-2">
                        <span>💡</span> Taktischer KI-Rat
                    </h2>
                    <p class="text-xs text-slate-400 mb-4">Erkenntnisse basierend auf Bundesliga-Form, Marktwerten und deinen Daten.</p>
                    <div id="aiOutput" class="bg-slate-950 border border-slate-800 p-4 rounded-xl text-sm text-slate-300 h-72 overflow-y-auto whitespace-pre-line leading-relaxed">
                        Noch keine Analyse vorhanden. Gib links deine Daten ein und klicke auf den Analyse-Button.
                    </div>
                </div>
                <div class="flex justify-between items-center mt-4 pt-2 border-t border-slate-800/60">
                    <span class="text-xs text-slate-500">Gespeichert im Browser-Speicher</span>
                    <button onclick="clearStorage()" class="text-xs text-rose-400 hover:text-rose-300 underline font-medium">
                        Speicher leeren
                    </button>
                </div>
            </div>

        </div>

        <!-- Sektion 3: Liga-Strategie & Notizen (Dauerhaft gespeichert) -->
        <div class="mt-6 bg-slate-900/80 border border-slate-800 p-6 rounded-2xl shadow-xl">
            <h2 class="text-lg font-bold mb-2 text-slate-200 flex items-center gap-2">
                <span>📝</span> Liga-Notizen & Strategie-Speicher
            </h2>
            <p class="text-xs text-slate-400 mb-3">Hier kannst du dir aufschreiben, wer in deiner Liga viel Geld hat, wen du als nächstes kaufst oder welche Absprachen gelten. (Wird automatisch live gespeichert!)</p>
            <textarea id="notesData" oninput="saveNotes()" rows="4" class="w-full bg-slate-950 border border-slate-800 p-3 rounded-xl text-sm text-slate-300 focus:outline-none focus:border-emerald-500 leading-relaxed" placeholder="Beispiel: Manager X hat noch 20 Millionen, braucht aber dringend einen Torwart..."></textarea>
        </div>
    </div>

    <script>
        // Automatisches Laden der gespeicherten Daten beim Start
        window.onload = function() {
            if(localStorage.getItem('kb_apikey')) {
                document.getElementById('apiKey').value = localStorage.getItem('kb_apikey');
            }
            if(localStorage.getItem('kb_notes')) {
                document.getElementById('notesData').value = localStorage.getItem('kb_notes');
            }
            if(localStorage.getItem('kb_market')) {
                document.getElementById('marketData').value = localStorage.getItem('kb_market');
            }
            if(localStorage.getItem('kb_last_analysis')) {
                document.getElementById('aiOutput').innerHTML = localStorage.getItem('kb_last_analysis');
            }
        };

        function saveApiKey() {
            const key = document.getElementById('apiKey').value.trim();
            localStorage.setItem('kb_apikey', key);
            alert('API-Key erfolgreich im Browser gespeichert!');
        }

        function saveNotes() {
            const notes = document.getElementById('notesData').value;
            localStorage.setItem('kb_notes', notes);
        }

        function clearStorage() {
            if(confirm('Möchtest du wirklich alle gespeicherten Daten und Notizen löschen?')) {
                localStorage.clear();
                location.reload();
            }
        }

        async function analyzeData() {
            const apiKey = document.getElementById('apiKey').value.trim();
            const marketData = document.getElementById('marketData').value.trim();
            const outputDiv = document.getElementById('aiOutput');

            if(!apiKey) {
                alert('Bitte trage oben deinen OpenAI API-Key ein!');
                return;
            }
            if(!marketData) {
                alert('Bitte gib im linken Feld Daten zu deinem Kader oder dem Transfermarkt ein.');
                return;
            }

            // Marktdaten direkt sichern
            localStorage.setItem('kb_market', marketData);

            outputDiv.innerHTML = "⏳ Die KI analysiert deinen Kader, den Transfermarkt und das Bundesliga-Geschehen...";

            try {
                const response = await fetch("https://api.openai.com/v1/chat/completions", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: "gpt-4o-mini", // Schnell, clever und günstig
                        messages: [
                            {
                                role: "system",
                                content: "Du bist ein genialer, erfahrener Kickbase-Profi und Bundesliga-Experte. Du kennst die Stärken und Schwächen aller Spieler, Verletzungshistorien, Rotationsrisiken unter den Trainern und Marktwert-Mechaniken (Gewinnmaximierung). Analysiere die Eingabe des Nutzers so, dass er seine Kickbase-Liga gewinnt. Gib glasklare Empfehlungen: Wer muss aufgestellt werden? Wer muss sofort gekauft werden? Wer sollte verkauft werden?"
                            },
                            {
                                role: "user",
                                content: marketData
                            }
                        ],
                        temperature: 0.7
                    })
                });

                const data = await response.json();
                
                if(data.error) {
                    outputDiv.innerHTML = `<span class="text-rose-400 font-bold">OpenAI Fehler: ${data.error.message}</span>`;
                } else {
                    const aiReply = data.choices[0].message.content;
                    outputDiv.innerHTML = aiReply;
                    // Letzte Analyse im Speicher sichern
                    localStorage.setItem('kb_last_analysis', aiReply);
                }
            } catch (error) {
                outputDiv.innerHTML = `<span class="text-rose-400 font-bold">Verbindungsfehler: ${error.message}</span>`;
            }
        }
    </script>
</body>
</html>
